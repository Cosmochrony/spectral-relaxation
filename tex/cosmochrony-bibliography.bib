@misc{Beau2026tb,
  author = {Beau, J\'er\^ome},
  title = {{Projective Trajectory Branching and the de Sitter Limit}},
  journal = {Working paper},
  year = {2026},
  note = {Result note: the LPS $\to$ Heisenberg transfer relocates exponential growth from endpoint volumes (polynomial, Bass--Guivarc'h degree 4) to projectively distinguishable histories. Endpoint-based distinguishability (D1--D3) provably collapses; the canonical O12-compatible residual channel is $b$-only (the central charge is unconditionally erased from mono-path norms) and its distinguishable-history count is the Pell count $N(n)=2N(n-1)+N(n-2)$, rate $h_b=\log(1+\sqrt2)$, proved for a generic probe and witnessed exactly at $q=211$. Structural bridge from the admissibility cascade to a de Sitter-like component independent of matter content; the full-history Gabor channel keeps a projective-compression profile as the open candidate for an evolving effective equation of state.
 \doi{10.5281/zenodo.21197757}}
}
