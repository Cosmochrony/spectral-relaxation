\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Kesten--McKay support edges $\lambda _\pm (p) = 1 \pm 2\sqrt  {p}/(p+1)$ as functions of the prime $p$, with the three ADE eigenvalue levels of $2I$ (ord-5, $|S|=24$) shown as horizontal dash-dotted lines. As $p$ grows, the support \emph  {narrows}: $\lambda _+ - \lambda _- = 4\sqrt  {p}/(p+1) \to 0$. The level $\lambda _3 = 5/4$ exits the support at $p = (4+\sqrt  {15})^2 \approx 62$; $\lambda _2 = 1$ never exits (it is the midpoint of the symmetric support); $\lambda _1 = 5/6$ exits at $p = (6+\sqrt  {35})^2 \approx 142$.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:O1-support}{{3}{14}{Kesten--McKay support edges $\lambda _\pm (p) = 1 \pm 2\sqrt {p}/(p+1)$ as functions of the prime $p$, with the three ADE eigenvalue levels of $2I$ (ord-5, $|S|=24$) shown as horizontal dash-dotted lines. As $p$ grows, the support \emph {narrows}: $\lambda _+ - \lambda _- = 4\sqrt {p}/(p+1) \to 0$. The level $\lambda _3 = 5/4$ exits the support at $p = (4+\sqrt {15})^2 \approx 62$; $\lambda _2 = 1$ never exits (it is the midpoint of the symmetric support); $\lambda _1 = 5/6$ exits at $p = (6+\sqrt {35})^2 \approx 142$}{figure.3}{}}
