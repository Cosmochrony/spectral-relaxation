\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Predicted $\qopname  \relax o{log}_{10}$ mass ratios under Reading\nobreakspace  {}A ($\mathcal  {M}_i \propto c_i/\qopname  \relax o{dim}\rho _i$) for $2I$ ord-4 (left) and $2I$ ord-5 (right), for all admissible primes $p$. Dashed horizontal lines show the observed Standard Model ratios for charged leptons, up-type quarks, and down-type quarks. The predicted ratios lie within $[-1, +1]$ on the log scale, whereas the observed ratios reach $-5$ for up-type quarks.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:reading-A}{{2}{12}{Predicted $\log _{10}$ mass ratios under Reading~A ($\mathcal {M}_i \propto c_i/\dim \rho _i$) for $2I$ ord-4 (left) and $2I$ ord-5 (right), for all admissible primes $p$. Dashed horizontal lines show the observed Standard Model ratios for charged leptons, up-type quarks, and down-type quarks. The predicted ratios lie within $[-1, +1]$ on the log scale, whereas the observed ratios reach $-5$ for up-type quarks}{figure.2}{}}
