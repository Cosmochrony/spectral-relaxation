\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Kesten--McKay spectral density $\rho _{\mathrm  {KM}}^{(p)}(\lambda )$ for $(p+1)$-regular graphs with $p \in \{5, 13, 29, 53\}$. The support $[\lambda _-, \lambda _+]$ narrows as $p$ grows. Dashed vertical lines mark the three normalised eigenvalue levels of the $2I$ ord-5 ADE case ($\lambda _1 = 20/24$, $\lambda _2 = 1$, $\lambda _3 = 30/24$). All three levels lie inside the support for $p \leq 53$; the structural identity $F_{\mathrm  {KM}}(1) = 1/2$ follows from the symmetry of the density about $\lambda = 1$.}}{10}{figure.1}\protected@file@percent }
\newlabel{fig:km-density}{{1}{10}{Kesten--McKay spectral density $\rho _{\mathrm {KM}}^{(p)}(\lambda )$ for $(p+1)$-regular graphs with $p \in \{5, 13, 29, 53\}$. The support $[\lambda _-, \lambda _+]$ narrows as $p$ grows. Dashed vertical lines mark the three normalised eigenvalue levels of the $2I$ ord-5 ADE case ($\lambda _1 = 20/24$, $\lambda _2 = 1$, $\lambda _3 = 30/24$). All three levels lie inside the support for $p \leq 53$; the structural identity $F_{\mathrm {KM}}(1) = 1/2$ follows from the symmetry of the density about $\lambda = 1$}{figure.1}{}}
\newlabel{lem:monotonicity}{{4.1}{10}{Monotonicity}{lemma.4.1}{}}
